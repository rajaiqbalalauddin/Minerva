# Non-secret Cloud Functions config. Copy to functions/.env and fill in.
# Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) are NOT here — set those
# with: firebase functions:secrets:set STRIPE_SECRET_KEY

# Stripe recurring Price IDs (Stripe Dashboard > Products). e.g. price_123...
STRIPE_PRICE_MONTHLY= price_1TmLPgEQBLr7GE0uujqfP5ro
STRIPE_PRICE_YEARLY= price_1TmOFNEQBLr7GE0uNG6qvJah

# Where Stripe sends the user back after checkout (your deployed app URL in prod).
APP_URL=http://localhost:5173
